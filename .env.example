# Copy to .env (local) or set in Vercel > Project > Environment Variables. Never prefix with VITE_.
ANTHROPIC_API_KEY=your-key-here
# optional, improves plant species accuracy (free key from my.plantnet.org):
# PLANTNET_API_KEY=your-plantnet-key
# optional: ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Sign-in (Firebase Auth: Google + phone OTP). Firebase web config is public, so VITE_ prefix is correct here.
# Console > Project settings > Your apps > Web app > config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
